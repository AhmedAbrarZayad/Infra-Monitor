# ──────────────────────────── Django ────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────── Database ─────────────────────────
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=ai-infra-monitor
# Host-machine Django commands connect through the published Compose port.
DB_HOST=localhost
DB_PORT=5433
DB_CONN_MAX_AGE=60

# Dummy engineer seed command defaults. Override these when needed.
SEED_ENGINEER_USERNAME=engineer
SEED_ENGINEER_EMAIL=engineer@example.com
SEED_ENGINEER_PASSWORD=Engineer123!

# ──────────────────── Google OAuth 2.0 SMTP ────────────────────
# 1. Go to Google Cloud Console → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Desktop or Web type)
# 3. Enable the Gmail API
# 4. Use OAuth 2.0 Playground or google-auth-oauthlib to obtain a refresh token
GMAIL_SENDER_EMAIL=your-email@gmail.com
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# ──────────────────── JWT Configuration ────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ──────────────────── Frontend URLs ────────────────────────────
FRONTEND_WEB_URL=http://localhost:3000

# ──────────── CORS (comma-separated origins) ──────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ──────────── OTP Configuration ───────────────────────────────
OTP_EXPIRY_MINUTES=10
MONITORING_ENROLLMENT_EXPIRY_MINUTES=15
MONITORING_INSTALL_URL=https://monitor.example/api/monitoring/install.sh
MONITORING_PUBLIC_BASE_URL=https://monitor.example
MONITORING_CREDENTIAL_OVERLAP_MINUTES=15
MONITORING_REMOTE_WRITE_MAX_COMPRESSED_BYTES=10485760
MONITORING_REMOTE_WRITE_MAX_DECOMPRESSED_BYTES=104857600
VICTORIAMETRICS_INSERT_URL=http://vminsert:8480
VICTORIAMETRICS_WRITE_TIMEOUT_SECONDS=10
VICTORIAMETRICS_SELECT_URL=http://vmselect:8481
VICTORIAMETRICS_QUERY_TIMEOUT_SECONDS=10
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SERVICE_LIFECYCLE_INTERVAL_SECONDS=30
SERVICE_STALE_AFTER_SECONDS=90
SERVICE_OFFLINE_AFTER_SECONDS=300

# Shared only by Django and the private FastAPI ML service.
ML_SERVICE_URL=http://ml_service:80
ML_SERVICE_TOKEN=replace-with-a-random-shared-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=60
ASSISTANT_WS_TICKET_TTL_SECONDS=60
ML_REQUEST_TIMEOUT_SECONDS=30
ML_TRAINING_LOOKBACK_HOURS=24
ML_INFERENCE_WINDOW_SECONDS=300
ML_METRIC_STEP_SECONDS=60
ML_ORCHESTRATION_INTERVAL_SECONDS=300

# Production reverse proxy settings. Use the externally visible HTTPS origin.
USE_X_FORWARDED_HOST=True
CSRF_TRUSTED_ORIGINS=https://monitor.example
